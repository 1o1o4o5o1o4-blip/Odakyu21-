import streamlit as st
import requests

# 画面の設定
st.set_page_config(page_title="過疎スタ検索", page_icon="🔍")
st.title("🔍 過疎スタ 検索アプリ")

# 1. データの読み込み
# エラーが起きてもアプリが止まらないように「try」を使うよ
@st.cache_data(ttl=60)
def get_data():
    url = "https://api.scratch.mit.edu/studios/51326987/comments?limit=40"
    headers = {"User-Agent": "Mozilla/5.0"}
    try:
        r = requests.get(url, headers=headers, timeout=10)
        return r.json()
    except:
        return None

# 2. 実行
data = get_data()

if data is None:
    st.error("Scratchのデータが取れませんでした。リロードしてみてね。")
    # もし requirements.txt がないと、ここで「requestsが無いよ」というエラーがログに出るよ
else:
    st.success(f"最新の {len(data)} 件を表示中！")
    
    # 検索バー
    q = st.sidebar.text_input("キーワード検索")
    
    # 3. 表示
    for c in data:
        user = c.get('author', {}).get('username', '???')
        content = c.get('content', '')
        
        # 検索ワードが入っているかチェック
        if q.lower() in content.lower() or q.lower() in user.lower():
            st.markdown(f"**{user}**")
            st.write(content)
            st.divider()
