import streamlit as st
import requests

# ページの設定
st.set_page_config(page_title="過疎スタ最強検索", page_icon="🔥", layout="wide")
st.title("🔥 過疎スタ・絶対に動く検索アプリ")

# --- 1. データの読み込み（2段構え！） ---
@st.cache_data(ttl=60)
def get_safe_data():
    # 1番目の作戦：今の本物の過疎スタから取る
    url1 = "https://api.scratch.mit.edu/studios/51326987/comments?limit=40"
    # 2番目の作戦：もしダメならGitHubのバックアップから取る（君が最初に教えてくれたやつ！）
    url2 = "https://raw.githubusercontent.com/hd3a/kasosuta-dataset/refs/heads/main/scratch_shinya_all.json"
    
    headers = {"User-Agent": "Mozilla/5.0"}

    # まず1番目を試す
    try:
        r = requests.get(url1, headers=headers, timeout=5)
        if r.status_code == 200:
            return r.json(), "最新の過疎スタ"
    except:
        pass

    # 1番目がダメなら2番目を試す
    try:
        r = requests.get(url2, timeout=5)
        if r.status_code == 200:
            return r.json(), "バックアップ（過去ログ）"
    except:
        pass
        
    return None, None

# --- 2. 実行 ---
data, mode = get_safe_data()

if data is None:
    st.error("😭 全ての接続に失敗しました。requirements.txt を確認してください！")
else:
    st.success(f"✅ {mode} からデータを読み込みました！")
    
    # 検索機能
    st.sidebar.title("🔍 検索メニュー")
    q = st.sidebar.text_input("名前や言葉を入れてね")

    # --- 3. 表示（データの形が違っても動くように調整） ---
    for c in data:
        # 本物データとバックアップデータの両方に対応する書き方
        user = "不明"
        if isinstance(c.get('author'), dict):
            user = c['author'].get('username', '不明')
        else:
            user = c.get('user', '不明')
            
        content = c.get('content', '')

        if q.lower() in user.lower() or q.lower() in content.lower():
            with st.container():
                st.markdown(f"👤 **{user}**")
                st.info(content)
                st.divider()
