import streamlit as st
import requests
import time

st.set_page_config(page_title="過疎スタ 1000件データベース", layout="wide")
st.title("📂 過疎スタ 1000件データベース")

# 1. 1000件取得する関数
@st.cache_data(ttl=600)
def load_1000_comments():
    all_data = []
    # 40件 × 25回 = 1000件
    max_pages = 25
    
    headers = {"User-Agent": "Mozilla/5.0"}
    
    bar = st.progress(0)
    status = st.empty()

    for i in range(max_pages):
        offset = i * 40
        url = f"https://api.scratch.mit.edu/studios/51326987/comments?offset={offset}&limit=40"
        
        try:
            status.text(f"📥 データを読み込み中... ({len(all_data)}件)")
            r = requests.get(url, headers=headers, timeout=10)
            if r.status_code != 200:
                break
            
            res_data = r.json()
            if not res_data:
                break
                
            all_data.extend(res_data)
            bar.progress((i + 1) / max_pages)
            time.sleep(0.1) # パンク防止
        except:
            break
            
    status.empty()
    bar.empty()
    return all_data

# 2. 実行
with st.spinner("過疎スタの深層へ潜入中..."):
    comments = load_1000_comments()

if not comments:
    st.error("データが取れませんでした。requirements.txtがあるか確認してね。")
else:
    st.success(f"✅ {len(comments)}件の読み込み完了！")

    # 3. 検索機能
    q = st.text_input("🔍 ユーザー名やキーワードで検索")

    # 4. 表示
    for c in comments:
        user = c.get('author', {}).get('username', '不明')
        content = c.get('content', '')
        timestamp = c.get('datetime_created', '')

        if q.lower() in user.lower() or q.lower() in content.lower():
            with st.chat_message("user"):
                st.write(f"**{user}** ({timestamp})")
                st.write(content)
